# =========================================================================
# API
# Copy to .env.local and fill in.
# =========================================================================

# The API's origin, e.g. http://localhost:8080. Required.
API_URL=


# =========================================================================
# PRE-LAUNCH GATE
# =========================================================================

# The gate's Basic-Auth password. Optional.
SITE_PASSWORD=

# The gate's Basic-Auth username. Optional.
SITE_USER=

# A token that lets a browser past the gate. Optional; a credential.
SITE_BYPASS_TOKEN=


# =========================================================================
# RATE LIMITING PER VISITOR
# =========================================================================

# The key this app identifies itself with to the API's rate limiter. Optional; leave empty locally.
PROXY_KEY=


# =========================================================================
# ERROR TRACKING
# =========================================================================

# The error tracker's DSN — a URL holding the project's key and id. Optional; leave empty locally.
SENTRY_DSN=
