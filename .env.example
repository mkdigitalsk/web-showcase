# Left empty in dev so requests stay same-origin and the dev server's /v1 proxy carries them. A value
# becomes the axios baseURL, and anything other than a bare path stops matching the proxy prefix.
API_URL=

# Where that proxy forwards. Defaults to the production API when unset — and the showcase has no
# deployed preview, so a sign-up while developing becomes a real row. Point it at a server you run:
#   API_PROXY_TARGET=http://localhost:8080
# Started from the kmp-showcase checkout, not this one:
#   docker compose up db -d && ./gradlew :server:run
#   node scripts/seed-users.mjs --env=local
API_PROXY_TARGET=
