# The API the app's own /v1 proxy forwards to — an origin, read by the dev server here and by the edge
# middleware at runtime in a deployment, never by the bundle. The dev server refuses to start without it.
#   API_URL=http://localhost:8080
API_URL=

# The key the API checks beside X-Visitor-IP, so its rate limiter counts each visitor rather than the platform's
# egress — the platform's variables in a deployment. Leave it empty here: the dev server has no x-real-ip to name.
PROXY_KEY=
