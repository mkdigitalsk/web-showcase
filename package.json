{
  "name": "web-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "e2e": "bash scripts/run-e2e.sh",
    "build": "tsc -b && react-router build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-locales": "node scripts/check-locales.mjs",
    "types:api": "spec=\"$(./scripts/api-spec.sh)\" && openapi-typescript \"$spec\" --output src/shared/api/generated/schema.d.ts",
    "types:check": "npm run types:api && git diff --exit-code -- src/shared/api/generated/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint:md": "markdownlint-cli2",
    "lint:sh": "git ls-files -z '*.sh' | xargs -0 shellcheck",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@mkdigitalsk/design-system": "2.1.1",
    "@sentry/browser": "^11.12.0",
    "@sentry/core": "^11.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.3",
    "@vercel/speed-insights": "^2.1.0",
    "axios": "^1.21.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "isbot": "^5.2.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-intl": "^12.1.7",
    "react-resizable-panels": "^4.22.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
